+      nowMs = Math.max(nowMs, next.dueAt);
+      fired += 1;
+      firedLog.push({ delay: next.delay, atMs: nowMs });
+      next.cb();
+    }
+    nowMs = Math.max(nowMs, target);
+    return fired;
+  }
